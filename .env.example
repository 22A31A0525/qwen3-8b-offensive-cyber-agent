# ==============================================================================
# Qwen3-8B Cybersecurity Agent (v3 Pipeline) - Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the repository root and fill in your credentials.

# Hugging Face Configuration
HF_TOKEN=hf_your_token_here
HF_MODEL_ID=Qwen/Qwen3-8B
HF_REPO_ID=your-username/qwen3-8b-offensive-cyber-agent

# LLM-as-a-Judge Reasoning Evaluation (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Kaggle API Credentials
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Optional: Comma-separated Kaggle accounts for dynamic multi-GPU evaluation sharding
KAGGLE_ACCOUNTS=
